{
  "name": "cactusralph-coder",
  "version": "1.0.0",
  "description": "API service connecting Dolittle Rosetta to a Neo4j graph layer",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "jest --runInBand --forceExit",
    "lint": "eslint src tests"
  },
  "dependencies": {
    "cors": "2.8.5",
    "dotenv": "16.4.7",
    "express": "4.22.1",
    "express-rate-limit": "^8.3.2",
    "jsonwebtoken": "9.0.2",
    "neo4j-driver": "5.28.1"
  },
  "devDependencies": {
    "eslint": "9.39.4",
    "jest": "29.7.0",
    "supertest": "7.1.3"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT"
}
